{
  "name": "noe-agent",
  "productName": "Noe Agent",
  "version": "0.2.0-beta.1",
  "description": "一键安装、配置 AI CLI，并像聊天软件一样和 Claude Code / Codex / DeepSeek Harness 等私聊、拉群、@ 干活",
  "license": "MIT",
  "author": "haha362636-coder",
  "homepage": "https://github.com/haha362636-coder/noe-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/haha362636-coder/noe-agent.git"
  },
  "bugs": {
    "url": "https://github.com/haha362636-coder/noe-agent/issues"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server/index.js",
    "build:vendor": "esbuild scripts/vendor-entry.js --bundle --minify --format=iife --outfile=public/vendor/vendor.js && cp node_modules/@xterm/xterm/css/xterm.css public/vendor/",
    "make:icon": "electron scripts/make-icon.js",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:mac-arm64": "electron-builder --mac --arm64",
    "dist:mac-x64": "electron-builder --mac --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14"
  },
  "build": {
    "appId": "com.noeagent.app",
    "productName": "Noe Agent",
    "copyright": "Copyright © 2026 Noe Agent",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json"
    ],
    "asarUnpack": [
      "server/pty_bridge.py"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0",
      "artifactName": "Noe-Agent-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Noe Agent ${version}",
      "artifactName": "Noe-Agent-${version}-mac-${arch}.${ext}"
    }
  }
}
